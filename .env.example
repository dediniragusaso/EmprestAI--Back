# EMPREST.AI - API (back). Copie para .env e preencha. Nenhum valor real aqui.
# Na Vercel, cadastre as mesmas chaves no projeto da API (preview e production).

NODE_ENV=development
PORT=3000

# Projeto Supabase: https://<project-ref>.supabase.co
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Origem do front (allowlist; varias separadas por virgula).
# Deve ser igual a URL do front; o front/.env aponta para esta API em VITE_API_URL.
CORS_ORIGIN="http://localhost:5173"

# Banco (Prisma). ADR-001 §5: runtime pelo pooler (porta 6543), migration pela conexao direta (5432).
# Local (supabase start): ambas apontam para 127.0.0.1:54322 com senha padrao 'postgres'.
# NUNCA rode migrate reset/dev com as credenciais do Supabase remoto.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
